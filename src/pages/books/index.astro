---
import BaseLayout from '../../layouts/BaseLayout.astro'
import books from '../../data/books.json'

const base = import.meta.env.BASE_URL
const basePath = base.endsWith('/') ? base : `${base}/`
const withBase = (href) => `${basePath}${href.replace(/^\//, '')}`
const sortedBooks = [...books].sort((a, b) => b.updated.localeCompare(a.updated) || a.title.localeCompare(b.title, 'ko'))
const totals = sortedBooks.reduce(
  (acc, book) => {
    acc.books += 1
    acc.chapters += book.progress.total || 0
    acc.summarized += book.progress.summarized || 0
    acc.pending += book.progress.pending || 0
    acc.failed += book.progress.failed || 0
    return acc
  },
  { books: 0, chapters: 0, summarized: 0, pending: 0, failed: 0 },
)
const statusLabel = (status) => {
  if (status === 'completed') return '완료'
  if (status === 'partial') return '진행 중'
  if (status === 'review') return '검토 필요'
  if (status === 'indexed') return '목차 확보'
  return status
}
---

<BaseLayout title="책 | 2nd Brain Public" description="온라인 책을 목차별로 수집하고 순차 요약한 학습 페이지입니다.">
  <main class="container section">
    <div class="section-header">
      <div>
        <p class="eyebrow">Book ingest</p>
        <h1>책</h1>
      </div>
      <p>전체 목차를 먼저 정리하고, 장별 상세 내용을 작은 배치로 보강합니다.</p>
    </div>

    <section class="book-library-stats" aria-label="책 수집 현황">
      <div>
        <span>책</span>
        <strong>{totals.books}</strong>
      </div>
      <div>
        <span>전체 장</span>
        <strong>{totals.chapters}</strong>
      </div>
      <div>
        <span>상세 요약</span>
        <strong>{totals.summarized}</strong>
      </div>
      <div>
        <span>대기</span>
        <strong>{totals.pending}</strong>
      </div>
    </section>

    <div class="book-list">
      {sortedBooks.map((book) => {
        const percent = book.progress.total
          ? Math.round((book.progress.summarized / book.progress.total) * 100)
          : 0
        const learningPoints = (book.keyPoints || []).slice(0, 3)
        return (
          <a class="book-list-item" href={withBase(`/books/${book.id}/`)}>
            <div>
              <span class="eyebrow">{book.domain} · {statusLabel(book.status)}</span>
              <h2>{book.title}</h2>
              <p>{book.summary || book.description}</p>
              {learningPoints.length > 0 && (
                <ul class="book-list-points">
                  {learningPoints.map((point) => <li>{point}</li>)}
                </ul>
              )}
              <div class="book-list-meta">
                <span>저자 {book.author || '확인 필요'}</span>
                <span>업데이트 {book.updated || '확인 필요'}</span>
              </div>
            </div>
            <div class="book-list-progress" aria-label={`상세 요약 ${percent}% 완료`}>
              <strong>{percent}%</strong>
              <span>{book.progress.summarized}/{book.progress.total}장</span>
              <progress value={book.progress.summarized} max={Math.max(book.progress.total, 1)}></progress>
              <em>{book.progress.pending}장 대기</em>
            </div>
          </a>
        )
      })}
    </div>
  </main>
</BaseLayout>
