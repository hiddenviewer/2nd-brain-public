---
import BaseLayout from '../../layouts/BaseLayout.astro'
import books from '../../data/books.json'

const base = import.meta.env.BASE_URL
const basePath = base.endsWith('/') ? base : `${base}/`
const withBase = (href) => `${basePath}${href.replace(/^\//, '')}`

export function getStaticPaths() {
  return books.map((book) => ({ params: { book: book.id }, props: { book } }))
}

const { book } = Astro.props
const percent = book.progress.total
  ? Math.round((book.progress.summarized / book.progress.total) * 100)
  : 0
const statusLabel = (status) => {
  if (status === 'completed') return '완료'
  if (status === 'partial') return '진행 중'
  if (status === 'review') return '검토 필요'
  if (status === 'indexed') return '목차 확보'
  if (status === 'summarized') return '요약 완료'
  if (status === 'pending') return '대기'
  if (status === 'failed') return '실패'
  return status
}
const chapterId = (chapter) => `chapter-${chapter.position}`
const detailBlocks = (detail = '') => detail
  .split('\n')
  .map((line) => line.trim())
  .filter(Boolean)
  .map((line) => {
    if (line.startsWith('### ')) return { type: 'h4', text: line.slice(4) }
    if (line.startsWith('## ')) return { type: 'h3', text: line.slice(3) }
    if (line.startsWith('# ')) return { type: 'h3', text: line.slice(2) }
    if (line.startsWith('- ')) return { type: 'bullet', text: line.slice(2) }
    return { type: 'paragraph', text: line }
  })
---

<BaseLayout title={`${book.title} | 2nd Brain Public`} description={book.summary}>
  <main class="book-page">
    <header class="book-header">
      <div>
        <a class="back-link" href={withBase('/books/')}>책 목록</a>
        <p class="eyebrow">{book.domain} · {statusLabel(book.status)}</p>
        <h1>{book.title}</h1>
        <p class="book-lead">{book.summary}</p>
        <div class="book-meta">
          <span>저자 {book.author || '확인 필요'}</span>
          <span>업데이트 {book.updated || '확인 필요'}</span>
          {book.sourceUrl && <a href={book.sourceUrl} target="_blank" rel="noreferrer">원문</a>}
        </div>
      </div>
      <div class="book-progress-summary">
        <strong>{percent}%</strong>
        <span>상세 요약 {book.progress.summarized}/{book.progress.total}장</span>
        <progress value={book.progress.summarized} max={Math.max(book.progress.total, 1)}></progress>
        <small>대기 {book.progress.pending} · 실패 {book.progress.failed}</small>
      </div>
    </header>

    <section class="book-study-dashboard" aria-label="책 학습 현황">
      <div class="book-study-card primary">
        <span>상세 요약 완료</span>
        <strong>{book.progress.summarized}</strong>
        <small>{book.progress.total}개 장 중 {percent}%</small>
      </div>
      <div class="book-study-card">
        <span>다음 처리 대상</span>
        <strong>{Math.min(book.progress.pending + book.progress.failed, 3)}</strong>
        <small>배치 단위 장 수</small>
      </div>
      <div class="book-study-card">
        <span>대기</span>
        <strong>{book.progress.pending}</strong>
        <small>목차 요약만 보유</small>
      </div>
      <div class="book-study-card">
        <span>실패</span>
        <strong>{book.progress.failed}</strong>
        <small>재시도 대상</small>
      </div>
    </section>

    {book.keyPoints.length > 0 && (
      <section class="book-learning-points">
        <div>
          <p class="eyebrow">Learning map</p>
          <h2>이 책에서 배울 수 있는 것</h2>
        </div>
        <ul>{book.keyPoints.slice(0, 8).map((point) => <li>{point}</li>)}</ul>
      </section>
    )}

    <div class="book-reading-layout">
      <aside class="book-toc" aria-label="책 목차">
        <div class="book-toc-header">
          <h2>목차</h2>
          <div class="book-toc-filters" aria-label="목차 필터">
            <button type="button" class="active" data-book-filter="all">전체</button>
            <button type="button" data-book-filter="summarized">완료</button>
            <button type="button" data-book-filter="pending">대기</button>
            <button type="button" data-book-filter="failed">실패</button>
          </div>
        </div>
        <ol>
          {book.chapters.map((chapter) => (
            <li class:list={[chapter.status]} data-chapter-status={chapter.status}>
              <a href={`#${chapterId(chapter)}`}>
                <span>{chapter.position}</span>
                <span>{chapter.title}</span>
                <small>{statusLabel(chapter.status)}</small>
              </a>
            </li>
          ))}
        </ol>
      </aside>

      <article class="book-content">
        {book.chapters.map((chapter) => (
          <section
            id={chapterId(chapter)}
            class:list={['book-chapter', chapter.status, chapter.status !== 'summarized' && 'compact']}
            data-chapter-status={chapter.status}
          >
            <div class="book-chapter-heading">
              <div>
                <span class="chapter-number">{String(chapter.position).padStart(2, '0')}</span>
                <h2>{chapter.title}</h2>
              </div>
              <span class:list={['chapter-status', chapter.status]}>{statusLabel(chapter.status)}</span>
            </div>
            <p class="chapter-summary">{chapter.summary || '상세 수집 대기'}</p>

            {chapter.status === 'summarized' ? (
              <div class="chapter-detail">
                {detailBlocks(chapter.detail).map((block) => {
                  if (block.type === 'h3') return <h3>{block.text}</h3>
                  if (block.type === 'h4') return <h4>{block.text}</h4>
                  if (block.type === 'bullet') return <p class="detail-bullet">{block.text}</p>
                  return <p>{block.text}</p>
                })}
              </div>
            ) : chapter.status === 'failed' ? (
              <p class="chapter-notice">수집 실패: {chapter.error || '다음 배치에서 재시도합니다.'}</p>
            ) : (
              <p class="chapter-notice">이 장은 다음 상세 처리 배치를 기다리고 있습니다.</p>
            )}

            {chapter.url && <a class="chapter-source" href={chapter.url} target="_blank" rel="noreferrer">장 원문</a>}
          </section>
        ))}
      </article>
    </div>
  </main>
  <script>
    const filterButtons = Array.from(document.querySelectorAll('[data-book-filter]'))
    const filterTargets = Array.from(document.querySelectorAll('[data-chapter-status]'))

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-book-filter')
        filterButtons.forEach((item) => item.classList.toggle('active', item === button))
        filterTargets.forEach((target) => {
          const status = target.getAttribute('data-chapter-status')
          target.toggleAttribute('hidden', filter !== 'all' && status !== filter)
        })
      })
    })
  </script>
</BaseLayout>
